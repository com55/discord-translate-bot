# Copy to .dev.vars and fill in. .dev.vars is gitignored.
# Secrets used by the Worker (set in prod via `wrangler secret put <NAME>`):
DISCORD_PUBLIC_KEY=
DISCORD_APP_ID=
LLM_API_KEY=

# Provider + language config live in wrangler.jsonc [vars] (LLM_BASE_URL, LLM_MODEL,
# PRIMARY_LANG, SECONDARY_LANG). Uncomment here only to override them locally:
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=anthropic/claude-haiku-4.5
# PRIMARY_LANG=Thai
# SECONDARY_LANG=English

# Used only by scripts/register.ts (command registration), not by the Worker:
DISCORD_BOT_TOKEN=
