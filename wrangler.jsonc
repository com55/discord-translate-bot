{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "discord-translate-bot",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-12",
  "compatibility_flags": ["nodejs_compat"],
  // Non-secret provider config. Swap to any OpenAI-compatible endpoint here
  // (OpenAI, Groq, Together, local Ollama, ...). The API key is a secret:
  // `wrangler secret put LLM_API_KEY`.
  "vars": {
    "LLM_BASE_URL": "https://openrouter.ai/api/v1",
    "LLM_MODEL": "anthropic/claude-haiku-4.5",
    // Language pair for the context-menu "Translate": any source → PRIMARY_LANG;
    // a PRIMARY_LANG message flips to SECONDARY_LANG. Use full English names.
    "PRIMARY_LANG": "Thai",
    "SECONDARY_LANG": "English"
  },
  // Stores the original message behind a "translate a reply" button so the
  // result message itself stays translation-only. Create with
  // `wrangler kv namespace create REPLY_CTX` and paste the printed id here.
  "kv_namespaces": [
    { "binding": "REPLY_CTX", "id": "de6fec3120474db8968bae978097741f" }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
